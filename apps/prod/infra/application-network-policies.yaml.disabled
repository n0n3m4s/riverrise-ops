apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: network-policies
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
spec:
  project: infra
  source:
    repoURL: https://github.com/n0n3m4s/riverrise-ops.git
    targetRevision: main
    path: charts/network-policies
    helm:
      releaseName: network-policies
      valueFiles:
        - ../../environments/prod/values/network-policies.yaml
  destination:
    server: https://kubernetes.default.svc
    # Policies target multiple NS via metadata.namespace in templates.
    namespace: default
  syncPolicy:
    syncOptions:
      - ServerSideApply=true
